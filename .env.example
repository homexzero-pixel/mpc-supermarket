# ---- MPC Scan & Shop server configuration ----
# Copy to .env (never commit .env). Secrets stay on the server only.

PORT=3000
# Public https address customers reach (used in QR codes, canonical URLs, sitemap)
PUBLIC_BASE_URL=https://shop.example.in
# Let search engines index public pages (keep false until the real domain is live)
ALLOW_INDEXING=false
# Set to true when running behind a reverse proxy / load balancer (for client IPs)
TRUST_PROXY=true

# DEMO_MODE=true uses the POS simulator and allows sample data. Set false for production.
DEMO_MODE=false
DATABASE_PATH=data/mpc.db

# POS integration: simulator | http
POS_ADAPTER=http
POS_BASE_URL=https://pos.example.internal/api
# Supply the real key via your host's secret settings, not this file
POS_API_KEY=__set_in_secret_manager__

# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=__set_in_secret_manager__

STORE_TIMEZONE=Asia/Kolkata
CATALOGUE_SYNC_MINUTES=15
PRINT_LEASE_SECONDS=30
# Basket submissions allowed per IP per 10 minutes (shop Wi-Fi may share one IP)
CHECKOUT_RATE_LIMIT=30
